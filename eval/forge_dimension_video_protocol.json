{
    "protocol_version":  "forge-dimension-video-protocol-v1.1",
    "source":  "FORGE frozen dimension-separated video evaluation methodology",
    "reasoning_alignment":  {
                                "sampling":  "uniform_fps",
                                "fps":  2.0,
                                "judgment":  "manual_binary_questions",
                                "scale":  "0_or_1_question_accuracy"
                            },
    "temporal_consistency":  {
                                 "sampling":  "uniform_count",
                                 "frames":  16,
                                 "scale":  "0_to_100_mapped_judge_score"
                             },
    "physical_rationality":  {
                                 "sampling":  "uniform_count",
                                 "frames":  16,
                                 "scale":  "0_to_100_mapped_judge_score"
                             },
    "visual_quality":  {
                           "sampling":  "uniform_count",
                           "frames":  6,
                           "exclude_first_last":  true,
                           "scale":  "integer_1_to_3"
                       },
    "judge_groups":  {
                         "task":  [
                                      "reasoning_alignment",
                                      "industrial_logic_and_fact_alignment",
                                      "reference_and_motion_fidelity",
                                      "application_usefulness",
                                      "observable_event_coverage"
                                  ],
                         "visual_dynamics":  [
                                                 "geometric_integrity",
                                                 "physical_plausibility",
                                                 "temporal_consistency"
                                             ],
                         "visual_quality":  [
                                                "visual_quality"
                                            ]
                     },
    "conflict_arbitration":  {
                                 "shared_signal":  "task_realization_crosscheck",
                                 "absolute_delta_threshold":  35.0,
                                 "action":  "third_independent_judgment"
                             },
    "invalid_policy":  {
                           "max_retries":  2,
                           "status":  "evaluator_invalid",
                           "assign_zero_score":  false,
                           "include_in_aggregate":  false
                       },
    "cache_policy":  {
                         "require_protocol_version":  true,
                         "require_protocol_sha256":  true
                     },
    "headline_policy":  "paper-v5-separated-task-success-and-conditional-quality",
    "paper_metrics":  {
                          "task_success":  {
                                               "event_coverage_threshold":  60,
                                               "industrial_logic_threshold":  60,
                                               "reference_motion_threshold":  60,
                                               "aggregation":  "all_three_thresholds_must_pass"
                                           },
                          "conditional_quality":  {
                                                      "axes":  [
                                                                   "geometric_integrity",
                                                                   "physical_plausibility",
                                                                   "temporal_consistency",
                                                                   "reference_and_motion_fidelity",
                                                                   "visual_quality_score"
                                                               ],
                                                      "aggregation":  "arithmetic_mean_reported_for_all_valid_and_task_successful_samples"
                                                  },
                          "overall_utility":  {
                                                  "aggregation":  "task_success_indicator_times_all_case_conditional_quality",
                                                  "headline":  false
                                              }
                      }
}
