{
  "version": "forge-video-5plus1-gated-v1.0",
  "headline": {
    "technical_axes": [
      "industrial_logic_and_fact_alignment",
      "geometric_integrity",
      "physical_plausibility",
      "temporal_consistency",
      "reference_and_motion_fidelity"
    ],
    "application_axis": "application_usefulness",
    "formula": "0.8 * mean(technical_axes) + 0.2 * application_usefulness",
    "operator_gates": "apply_once_to_designated_axis_or_legacy_ranking_cap"
  },
  "judge": {
    "topology": "single_model_axis_specialized_calls",
    "temperature": 0.0,
    "required_output": ["score", "evidence", "failure_modes", "confidence"],
    "score_anchors": [[90, 100], [75, 89], [60, 74], [40, 59], [20, 39], [1, 19], [0, 0]],
    "evidence_required_below": 60,
    "positive_evidence_required_above": 85
  },
  "sampling": {
    "task_progress": {"fps": 2.0, "max_frames": 32, "include_first": true, "include_last": true},
    "dynamic_local": {"segments": 4, "consecutive_frames_per_segment": 4},
    "visual_quality": {"frames": 6, "exclude_boundaries": true}
  },
  "task_success": {"official_threshold": 60.0, "sensitivity_thresholds": [55.0, 60.0, 65.0]},
  "invalid_policy": {
    "model_output_invalid": {"ranking_score": 0},
    "evaluator_invalid": {"ranking_score": null, "ranking_status": "incomplete"}
  },
  "bootstrap": {"iterations": 1000, "seed": 1729, "confidence": 0.95},
  "cache_key_fields": ["protocol_version", "protocol_sha256", "video_sha256", "reference_sha256", "sample_sha256", "judge_model", "judge_model_version"]
}
