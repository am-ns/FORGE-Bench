{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FORGE-Bench Sample",
  "description": "Schema for each entry in dataset/annotations/samples.json",
  "type": "object",
  "required": [
    "task_id",
    "domain",
    "topology_type",
    "image_path",
    "prompt",
    "evaluation_prompt",
    "video_generation_prompt",
    "motion_type",
    "viewpoint_motion_target",
    "difficulty_level",
    "difficulty_profile",
    "constraint_annotations",
    "application_type",
    "application_objective",
    "event_graph",
    "required_observable_events",
    "decision_relevant_elements",
    "application_success_criteria",
    "misleading_failure_modes",
    "industrial_logic_questions",
    "implicit_rule_type",
    "reasoning_alignment_questions",
    "sensitivity_variants"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z]{2,8}(_[a-z]+){0,2}_[0-9]{3}$|^S[A-Z][0-9]{2}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "visual_security",
        "embodied_robotics",
        "heavy_load_construction",
        "precision_defect_gen",
        "extreme_emergency"
      ]
    },
    "topology_type": {
      "type": "string",
      "enum": ["surface", "lattice", "kinematic", "flexible"]
    },
    "primary_topology": {
      "type": "string",
      "enum": ["surface", "lattice", "kinematic", "flexible"]
    },
    "sub_topology": {
      "type": "string",
      "enum": [
        "articulated",
        "rotational",
        "aerodynamic",
        "rigid_housing",
        "2d_planar",
        "3d_spatial",
        "cable_hose"
      ]
    },
    "image_path": {
      "type": "string",
      "pattern": "^dataset[\\\\/]images(_hq)?[\\\\/](visual_security|embodied_robotics|heavy_load_construction|precision_defect_gen|extreme_emergency)[\\\\/]"
    },
    "prompt": {
      "type": "string",
      "description": "Legacy judge-facing evaluation prompt retained for compatibility.",
      "minLength": 50
    },
    "evaluation_prompt": {
      "type": "string",
      "description": "Judge-facing prompt with hidden scoring context. Generation models should use video_generation_prompt instead.",
      "minLength": 50
    },
    "video_generation_prompt": {
      "type": "string",
      "description": "Direct prompt intended for image-to-video generation models.",
      "minLength": 50
    },
    "motion_type": {
      "type": "string",
      "enum": ["orbit", "pan", "crane", "dolly", "tilt", "static"]
    },
    "viewpoint_motion_target": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^(orbit_(cw|ccw)_[0-9]+deg|crane_up_[0-9]+deg|horizontal_pan_lr|dolly_in_[0-9]+x)$"
        }
      ]
    },
    "difficulty_profile": {
      "type": "object",
      "description": "Per-axis difficulty classification for adversarial calibration.",
      "additionalProperties": {
        "type": "string",
        "enum": ["easy", "medium", "hard", "adversarial"]
      }
    },
    "difficulty_level": {
      "type": "string",
      "description": "Official aggregate content difficulty used for stratified benchmark reporting.",
      "enum": ["easy", "medium", "hard", "adversarial"]
    },
    "challenge_difficulty_level": {
      "type": ["string", "null"],
      "description": "Legacy challenge-focused label retained for provenance.",
      "enum": ["easy", "medium", "hard", "adversarial", null]
    },
    "content_difficulty_score": {
      "type": "number",
      "minimum": 0
    },
    "content_difficulty_factors": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "constraint_annotations": {
      "type": "object",
      "additionalProperties": true
    },
    "task_category": {
      "type": "string",
      "enum": [
        "rigid_body_kinematics_and_coupling",
        "topology_mutation_and_failure",
        "fluid_dynamics_and_thermodynamics",
        "spatial_exploration_and_viewpoint",
        "industrial_logic_and_compliance"
      ]
    },
    "scene_id": {
      "type": "string",
      "pattern": "^(vsec|erob|hload|pdef|emerg)_[a-z0-9_]+$"
    },
    "reference_subject": {
      "type": "string",
      "minLength": 3
    },
    "image_requirement": {
      "type": "string",
      "minLength": 20
    },
    "task_title": {
      "type": "string",
      "minLength": 5
    },
    "task_title_zh": {
      "type": "string",
      "minLength": 2
    },
    "application_value": {
      "type": "string",
      "minLength": 20
    },
    "application_type": {
      "type": "string",
      "enum": [
        "safety_training",
        "emergency_rehearsal",
        "robotic_operation",
        "inspection_and_maintenance",
        "heavy_operation_risk",
        "defect_generation"
      ]
    },
    "application_objective": {
      "type": "string",
      "minLength": 50
    },
    "event_graph": {
      "type": "object",
      "description": "Scene-specific causal application loop used by prompts and application-usefulness judging.",
      "required": [
        "initial_state",
        "trigger",
        "progression",
        "required_response",
        "terminal_state",
        "critical_decision"
      ],
      "properties": {
        "initial_state": { "type": "string", "minLength": 10 },
        "trigger": { "type": "string", "minLength": 10 },
        "progression": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "required_response": { "type": "string", "minLength": 10 },
        "terminal_state": { "type": "string", "minLength": 10 },
        "critical_decision": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": false
    },
    "required_observable_events": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "decision_relevant_elements": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "application_success_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "misleading_failure_modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "axis_weights": {
      "type": "object",
      "description": "Dynamic per-sample model-evaluation weights.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "axis_rubric": {
      "type": "object",
      "description": "Task-specific scoring criteria by axis.",
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    },
    "operator_plan": {
      "type": "array",
      "description": "Optional explicit task-conditioned operator plan; omitted samples use the evaluator's inferred plan.",
      "items": {
        "type": "object",
        "required": ["operator", "tier", "target", "expected_signal", "used_for_axis_cap"],
        "properties": {
          "operator": { "type": "string" },
          "tier": { "type": "string", "enum": ["axis_cap", "judge_evidence", "diagnostic"] },
          "target": { "type": "string" },
          "expected_signal": { "type": "string" },
          "used_for_axis_cap": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "failure_target": {
      "type": "string"
    },
    "industrial_logic_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "text", "answer"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "answer": {
            "type": "string",
            "enum": ["yes", "no"]
          },
          "weakness_target": {
            "type": "string",
            "enum": [
              "causal_chain_completeness",
              "required_observable_event_presence",
              "misleading_failure_mode_absence",
              "geometric_topology_preservation",
              "physical_plausibility",
              "temporal_consistency",
              "reference_fidelity"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "implicit_rule_type": {
      "type": "string",
      "description": "Dominant implicit world-rule family for RISE-style reasoning diagnostics.",
      "enum": [
        "causal_procedure",
        "physical_commonsense",
        "spatial_topology",
        "temporal_order",
        "safety_compliance",
        "subject_domain_knowledge",
        "perceptual_count_attribute",
        "reference_identity"
      ]
    },
    "reasoning_alignment_questions": {
      "type": "array",
      "description": "Binary reasoning questions used to compute reasoning_alignment_score.",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "text", "answer", "implicit_rule_type", "weakness_target"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 10 },
          "answer": {
            "type": "string",
            "enum": ["yes", "no"]
          },
          "implicit_rule_type": {
            "type": "string",
            "enum": [
              "causal_procedure",
              "physical_commonsense",
              "spatial_topology",
              "temporal_order",
              "safety_compliance",
              "subject_domain_knowledge",
              "perceptual_count_attribute",
              "reference_identity"
            ]
          },
          "weakness_target": {
            "type": "string",
            "enum": [
              "causal_chain_completeness",
              "required_observable_event_presence",
              "misleading_failure_mode_absence",
              "geometric_topology_preservation",
              "physical_plausibility",
              "temporal_consistency",
              "reference_fidelity"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sensitivity_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "difficulty", "prompt_delta", "viewpoint_motion_target_delta"],
        "properties": {
          "id": { "type": "string" },
          "difficulty": { "type": "string" },
          "prompt_delta": { "type": "string" },
          "viewpoint_motion_target_delta": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
